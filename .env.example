# GAMON Application Configuration
# Copy this file to .env and update values for your environment

# Database Configuration
DB_HOST=localhost
DB_NAME=gamon_db
DB_USER=root
DB_PASS=

# Security Configuration
JWT_SECRET=your-super-secret-jwt-key-here-change-this-in-production
SESSION_NAME=GAMON_SESSION
SESSION_TIMEOUT=86400

# File Upload Configuration
UPLOAD_MAX_SIZE=10485760
UPLOAD_ALLOWED_TYPES=image/jpeg,image/png,image/gif,image/webp,video/mp4,video/webm,audio/mpeg,audio/wav,audio/ogg
UPLOAD_PATH=uploads/

# Email Configuration (for notifications)
SMTP_HOST=localhost
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=noreply@gamon.app
SMTP_FROM_NAME=GAMON Team

# Application Configuration
APP_NAME=GAMON
APP_URL=http://localhost/gamon
APP_ENV=development
APP_DEBUG=true

# Rate Limiting
RATE_LIMIT_LOGIN=5
RATE_LIMIT_WINDOW=300

# Cron Configuration
CRON_UNLOCK_ENABLED=true
CRON_NOTIFICATION_ENABLED=true

# Security Options
ENABLE_CSRF_PROTECTION=true
ENABLE_XSS_PROTECTION=true
ENABLE_AUDIT_LOGGING=true